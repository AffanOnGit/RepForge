<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the splash screen -->
    <style name="Theme.RepForge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0D10</item>
        <item name="postSplashScreenTheme">@style/Theme.RepForge</item>
    </style>

    <!-- Main app theme (Compose handles theming, this is just the shell) -->
    <style name="Theme.RepForge" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0B0D10</item>
        <item name="android:navigationBarColor">#0B0D10</item>
        <item name="android:windowBackground">#0B0D10</item>
    </style>
</resources>
